#!/usr/bin/env bash
#
# tg_recv -- poll Telegram getUpdates ONCE for new messages.
#
# A command-line fallback for RECEIVING messages when the Claude Code telegram
# plugin/MCP is unavailable. Prints one line per new message:
#     <unix_ts>\t<from>\t<text>
# (or raw message JSON with --json). A persisted offset guarantees each message
# is returned only once. The bot token is read from the channel .env at runtime
# and is never printed. Prints nothing and exits 0 when there are no new messages.
#
# IMPORTANT: Telegram allows only ONE getUpdates consumer at a time. Run this
# ONLY while the telegram plugin/MCP is NOT running, otherwise the two will
# steal each other's updates. This is strictly a "plugin is down" fallback.
#
# Usage:
#   tg_recv            # human-readable lines, one per new message
#   tg_recv --json     # raw message JSON, one object per line
#
# Env overrides:
#   TELEGRAM_ENV_FILE    path to the .env (default: ~/.claude/channels/telegram/.env)
#   TELEGRAM_STATE_DIR   where to keep the offset (default: ~/.claude/channels/telegram)
#   TELEGRAM_POLL_TIMEOUT long-poll seconds (default: 20)
#
set -euo pipefail

ENV_FILE="${TELEGRAM_ENV_FILE:-$HOME/.claude/channels/telegram/.env}"
STATE_DIR="${TELEGRAM_STATE_DIR:-$HOME/.claude/channels/telegram}"
OFFSET_FILE="$STATE_DIR/.tg_recv_offset"
POLL_TIMEOUT="${TELEGRAM_POLL_TIMEOUT:-20}"
MODE="${1:-}"

[[ -r "$ENV_FILE" ]] || { echo "tg_recv: cannot read $ENV_FILE" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
: "${TELEGRAM_BOT_TOKEN:?tg_recv: TELEGRAM_BOT_TOKEN not set in $ENV_FILE}"

mkdir -p "$STATE_DIR"
offset="$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)"

resp="$(curl -sS -m "$((POLL_TIMEOUT + 15))" \
    "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getUpdates" \
    --data-urlencode "offset=${offset}" \
    --data-urlencode "timeout=${POLL_TIMEOUT}")"

printf '%s' "$resp" | grep -q '"ok":true' || { echo "tg_recv: API error: $resp" >&2; exit 1; }

# Parse with stdlib python3: emit messages and advance the stored offset.
# Pass the response via env (TG_RESP) so the heredoc is python's program on stdin.
TG_RESP="$resp" python3 - "$OFFSET_FILE" "$MODE" <<'PY'
import json, os, sys

resp = json.loads(os.environ["TG_RESP"])
offset_file = sys.argv[1]
mode = sys.argv[2] if len(sys.argv) > 2 else ""

max_id = None
for upd in resp.get("result", []):
    max_id = upd["update_id"]
    msg = upd.get("message") or upd.get("edited_message")
    if not msg:
        continue
    if mode == "--json":
        print(json.dumps(msg, ensure_ascii=False))
    else:
        frm = msg.get("from") or {}
        who = frm.get("username") or frm.get("first_name") or str(frm.get("id", "?"))
        print(f'{msg.get("date", "")}\t{who}\t{msg.get("text", "")}')

if max_id is not None:
    with open(offset_file, "w") as fh:
        fh.write(str(max_id + 1))
PY
